            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "AppointmentStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
