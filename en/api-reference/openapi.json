          "start": {
            "type": "string",
            "example": "09:00"
          },
          "end": {
            "type": "string",
            "example": "09:30"
          },
          "modality": {
            "type": "string",
            "enum": [
              "presencial",
              "virtual"
            ],
            "default": "presencial"
          },
          "box_id": {
            "type": "integer",
            "nullable": true
          },
          "appointment_status_id": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "notificate": {
            "type": "boolean",
            "default": false
          }
        }
