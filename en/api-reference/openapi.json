            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "last_page": {
            "type": "integer"
          }
        }
      },
      "Cashbox": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Banco ARS"
          },
          "type": {
            "type": "string",
            "example": "Cajas y Bancos"
          },
          "currency_id": {
            "type": "integer",
            "example": 1
          },
          "currency_code": {
            "type": "string",
            "example": "ARS"
          },
          "payment_methods": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "example": 4
                },
                "name": {
                  "type": "string",
                  "example": "Transferencia bancaria"
                }
              }
            }
          }
        }
      },
      "ExpenseCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 6
          },
          "name": {
            "type": "string",
            "example": "Servicios"
          },
          "currency_id": {
            "type": "integer",
            "example": 1
          },
          "currency_code": {
            "type": "string",
            "example": "ARS"
          }
        }
      },
      "ExpenseInput": {
        "type": "object",
        "required": [
          "cashbox_id",
          "expense_category_id",
          "amount",
          "date"
        ],
        "properties": {
          "cashbox_id": {
            "type": "integer",
            "description": "Cash box or bank ID (GET /cashboxes)",
            "example": 1
          },
          "expense_category_id": {
            "type": "integer",
            "description": "Expense category ID (GET /expense-categories). Same currency as the cash box.",
            "example": 6
          },
          "amount": {
            "type": "number",
            "description": "Amount, greater than 0, in the cash box's currency",
            "example": 1500.5
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Expense date (YYYY-MM-DD)",
            "example": "2026-09-30"
          },
          "payment_method_id": {
            "type": "integer",
            "description": "Required if the cash box has enabled payment methods; it must be one of them",
            "example": 4
          },
          "comment": {
            "type": "string",
            "maxLength": 1000,
            "example": "Luz de septiembre"
          },
          "cotization": {
            "type": "number",
            "description": "Optional. If not sent, OCLÜ's exchange rate for the day is used",
            "example": 1452.25
          }
        }
      },
      "Expense": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 21
          },
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-09-30"
          },
          "amount": {
            "type": "number",
            "example": 1500.5
          },
          "currency_code": {
            "type": "string",
            "example": "ARS"
          },
          "cotization": {
            "type": "number",
            "example": 1452.25
          },
          "comment": {
            "type": "string",
            "nullable": true,
            "example": "Luz de septiembre"
          },
          "has_receipt": {
            "type": "boolean",
            "example": false
          },
          "expense_category": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "cashbox": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "payment_method_id": {
            "type": "integer",
            "nullable": true,
            "example": 4
          },
          "created_at": {
            "type": "string",
            "example": "2026-09-30 16:02:18"
          }
        }
      }
