{
  "openapi": "3.1.0",
  "info": {
    "title": "OCLÜ Public API",
    "description": "API for integrating OCLÜ with external systems (n8n, Make, Zapier, CRMs). Authentication by API key. Dates and times are in the clinic's local time. The API never exposes clinical data.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{tenant}.oclucrm.com/api/v1",
      "description": "Replace {tenant} with your clinic's subdomain",
      "variables": {
        "tenant": {
          "default": "your-clinic"
        }
      }
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "summary": "Verify connection",
        "description": "Returns the tenant, the locations the key can access and its permissions.",
        "tags": [
          "General"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/organizations": {
      "get": {
        "summary": "List locations",
        "tags": [
          "Catalogs"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Organization"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/doctors": {
      "get": {
        "summary": "List clinicians",
        "tags": [
          "Catalogs"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/Page"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedDoctors"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/doctors/{id}/schedules": {
      "get": {
        "summary": "Clinician schedules",
        "tags": [
          "Catalogs"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DoctorSchedule"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/doctors/{id}/available-slots": {
      "get": {
        "summary": "Available slots",
        "description": "Free slots for a clinician on a given date, excluding time outside their schedule, lunch breaks and existing appointments.",
        "tags": [
          "Availability"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Date DD-MM-YYYY",
            "schema": {
              "type": "string",
              "example": "23-06-2026"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "required": false,
            "description": "Minutes per appointment",
            "schema": {
              "type": "integer",
              "example": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailableSlots"
                }
              }
            }
          }
        }
      }
    },
    "/services": {
      "get": {
        "summary": "List services",
        "description": "Treatment catalog with prices.",
        "tags": [
          "Catalogs"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/Page"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Service"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/appointment-statuses": {
      "get": {
        "summary": "Appointment statuses",
        "tags": [
          "Catalogs"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AppointmentStatus"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/genders": {
      "get": {
        "summary": "Genders",
        "tags": [
          "Catalogs"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/countries": {
      "get": {
        "summary": "Countries",
        "tags": [
          "Catalogs"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/phone-prefixes": {
      "get": {
        "summary": "Phone prefixes",
        "tags": [
          "Catalogs"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/boxes": {
      "get": {
        "summary": "List treatment rooms",
        "tags": [
          "Catalogs"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Box"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/OrgRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/appointments": {
      "get": {
        "summary": "List appointments",
        "tags": [
          "Appointments"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Start date (DD-MM-YYYY or YYYY-MM-DD)"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "doctor_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "patient_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/Page"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedAppointments"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create appointment",
        "description": "Requires write permission.",
        "tags": [
          "Appointments"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Appointment"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/BusinessRule"
          }
        }
      }
    },
    "/appointments/{id}": {
      "get": {
        "summary": "Get an appointment",
        "tags": [
          "Appointments"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Appointment"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "summary": "Edit / reschedule appointment",
        "description": "Requires write permission. All fields are optional; changing the date/time reschedules the appointment.",
        "tags": [
          "Appointments"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Appointment"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/BusinessRule"
          }
        }
      },
      "delete": {
        "summary": "Cancel appointment",
        "description": "Requires write permission.",
        "tags": [
          "Appointments"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancelled"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/appointments/{id}/history": {
      "get": {
        "summary": "Appointment history",
        "tags": [
          "Appointments"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/patients/search": {
      "get": {
        "summary": "Search patients by name",
        "tags": [
          "Patients"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Minimum 3 characters",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Patient"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/patients/find-by-phone": {
      "get": {
        "summary": "Find patient by phone",
        "tags": [
          "Patients"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          },
          {
            "name": "phone",
            "in": "query",
            "required": true,
            "description": "Minimum 6 digits; matches on the last 8",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Patient"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/patients": {
      "get": {
        "summary": "List patients",
        "tags": [
          "Patients"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/Page"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedPatients"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create patient",
        "description": "Requires write permission. Contact/identification data only (never clinical).",
        "tags": [
          "Patients"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Patient"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/patients/{id}": {
      "get": {
        "summary": "Get a patient",
        "tags": [
          "Patients"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Patient"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "summary": "Update patient",
        "description": "Requires write permission. Partial update: send only the fields you want to change. Uses the OCLÜ id (the one returned by the POST). Contact/identification data only (never clinical). The ID document must still be unique. The change is recorded in the patient's history.",
        "tags": [
          "Patients"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Patient"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/cashboxes": {
      "get": {
        "summary": "List cash boxes and banks",
        "description": "The location's cash boxes and banks that an expense can be recorded from, with their currency and enabled payment methods.",
        "tags": [
          "Expenses"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Cashbox"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/OrgRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/expense-categories": {
      "get": {
        "summary": "List expense categories",
        "description": "The location's expense categories (Rent, Supplies, Salaries...), with their currency.",
        "tags": [
          "Expenses"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ExpenseCategory"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/OrgRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/expenses": {
      "post": {
        "summary": "Record expense",
        "description": "Requires write permission. Records an outgoing payment from a cash box or bank, assigned to an expense category, the same as in Treasury → Expenses. The cash box and the category must be in the same currency. To attach the receipt, send the request as multipart/form-data.",
        "tags": [
          "Expenses"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentOrgId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpenseInput"
              }
            },
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ExpenseInput"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "receipt": {
                        "type": "string",
                        "format": "binary",
                        "description": "Receipt: jpg, jpeg, png, webp, heic or pdf, up to 20 MB"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Expense"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "description": "Business rule: CASHBOX_NOT_FOUND, EXPENSE_CATEGORY_NOT_FOUND, CURRENCY_MISMATCH, PAYMENT_METHOD_REQUIRED or PAYMENT_METHOD_INVALID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "The clinic's API key. Header: Authorization: Bearer oclu_live_..."
      }
    },
    "parameters": {
      "CurrentOrgId": {
        "name": "Current-Org-Id",
        "in": "header",
        "required": true,
        "description": "Location ID (see GET /me)",
        "schema": {
          "type": "integer",
          "example": 1
        }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "description": "Results per page (max. 100)",
        "schema": {
          "type": "integer",
          "default": 50
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 1
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, invalid or revoked API key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "No permission (scope), no access to the location, or add-on not enabled",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "OrgRequired": {
        "description": "Missing Current-Org-Id header",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Invalid data",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "BusinessRule": {
        "description": "Business rule (time outside the schedule, overlap, etc.)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
