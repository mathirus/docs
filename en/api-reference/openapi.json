            "type": "integer"
          },
          "modality": {
            "type": "string",
            "enum": [
              "presencial",
              "virtual"
            ]
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "patient": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "doctor": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "box_id": {
            "type": "integer"
          },
          "google_meet_link": {
            "type": "string"
          }
        }
      },
      "AppointmentInput": {
        "type": "object",
        "required": [
          "doctor_id",
          "patient_id",
          "date",
          "start",
          "end"
